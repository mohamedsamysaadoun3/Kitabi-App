<?xml version="1.0" encoding="utf-8"?>
<!-- موارد السمات لتطبيق كتابي -->
<resources>

    <!-- سمة شاشة البداية -->
    <style name="Theme.Kitabi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Kitabi</item>
    </style>

    <!-- السمة الرئيسية لتطبيق كتابي - تستخدم Material3 من Compose -->
    <style name="Theme.Kitabi" parent="android:Theme.Material.Light.NoActionBar">
        <!-- دعم RTL -->
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textDirection">rtl</item>

        <!-- شريط الحالة -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- شريط التنقل -->
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- السمة الداكنة -->
    <style name="Theme.Kitabi.Dark" parent="android:Theme.Material.NoActionBar">
        <!-- دعم RTL -->
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textDirection">rtl</item>

        <!-- شريط الحالة الداكن -->
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- شريط التنقل الداكن -->
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
